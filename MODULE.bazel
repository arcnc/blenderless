module(
    name = "blenderless",
    version = "",
)

bazel_dep(
    name = "rules_python",
    version = "2.3.2",
)

# bpy wheels are built for exactly one CPython minor version per Blender release (Blender 4.5 LTS: 3.11).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11.18",
)

python.single_version_override(
    python_version = "3.11.18",
    sha256 = {
        "aarch64-apple-darwin": "3afb0567b2a2b30b3a7341bd143cb4e8a69f3d8e95d4641218eaa45f0fabbd07",
        "aarch64-unknown-linux-gnu": "7e71f26a003949b57757e287f4f4b6689da07e7a229f5bbee7919c19ed77155d",
        "x86_64-unknown-linux-gnu": "3288c54cea3db350052019b3f8b558dd8a3da8afa6fda573f5fd2bcb37635b4a",
    },
    urls = ["20261110/cpython-{python_version}+20261110-{platform}-install_only_stripped.tar.gz"],
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "blenderless_pip_deps",
    python_version = "3.11.18",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "blenderless_pip_deps")
